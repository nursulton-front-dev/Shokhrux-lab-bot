+services:
+  bot:
+    build: .
+    container_name: fitness_bot
+    restart: unless-stopped
+    init: true
+    stop_grace_period: 60s
+    security_opt:
+      - no-new-privileges:true
+    env_file:
+      - .env
+    environment:
+      LOG_FILE: /app/logs/bot.log
+      TZ: Asia/Tashkent
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "3"
+    volumes:
+      # Persist tariff banners / fonts and rotating logs across restarts.
+      - bot_assets:/app/assets
+      - bot_logs:/app/logs
+    # By default DATABASE_URL points at Neon PostgreSQL (cloud) — no local DB
+    # container is needed. To run a local Postgres instead, enable the profile
+    # below and repoint DATABASE_URL at the 'postgres' service.
+    # depends_on:
+    #   postgres:
+    #     condition: service_healthy
+
+  # Optional local PostgreSQL for development without Neon.
+  # Start with:  docker compose --profile local-db up -d
+  # Then set:    DATABASE_URL=postgresql+asyncpg://fitness:fitness@postgres:5432/fitness_bot
+  postgres:
+    image: postgres:16-alpine
+    container_name: fitness_bot_db
+    profiles: ["local-db"]
+    restart: unless-stopped
+    environment:
+      TZ: Asia/Tashkent
+      POSTGRES_USER: ${POSTGRES_USER:-fitness}
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-fitness}
+      POSTGRES_DB: ${POSTGRES_DB:-fitness_bot}
+    volumes:
+      - pg_data:/var/lib/postgresql/data
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "3"
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-fitness}"]
+      interval: 10s
+      timeout: 5s
+      retries: 5
+
+volumes:
+  bot_assets:
+  bot_logs:
+  pg_data:
