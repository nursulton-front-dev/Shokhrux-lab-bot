# ===== Telegram =====
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated list of admin Telegram IDs (e.g. 111111111,222222222)
ADMIN_IDS=111111111
# Optional single support account id (also treated as admin)
SUPPORT_ID=111111111
SUPPORT_USERNAME=your_support_username

# Main closed fitness channel id (bot must be admin there). Example: -1001234567890
CHANNEL_ID=-1001234567890
# Closed VIP group id for 6-month clients. Bot must be admin with "Ban users"
# and "Invite users via link" rights. Example: -1009876543210
VIP_CHAT_ID=-1009876543210

# ===== Database (Neon PostgreSQL or local) =====
# Neon example (async driver added automatically at runtime):
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Local docker profile example:
# DATABASE_URL=postgresql+asyncpg://fitness:fitness@postgres:5432/fitness_bot

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=your_gemini_api_key

# ===== Optional =====
# Referral cashback amount in UZS (default 30000)
CASHBACK_REWARD_AMOUNT=30000
# Log file path (default bot.log; Docker uses /app/logs/bot.log)
# LOG_FILE=bot.log
