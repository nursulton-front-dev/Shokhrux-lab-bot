# ===== Telegram =====
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated list of admin Telegram IDs (e.g. 111111111,222222222)
ADMIN_IDS=111111111
# Optional single support account id (also treated as admin)
SUPPORT_ID=111111111
SUPPORT_USERNAME=your_support_username

# Main closed fitness channel id (bot must be admin there). Example: -1001234567890
CHANNEL_ID=-1001234567890
# Closed VIP group id for 6-month clients. Bot must be admin with "Ban users"
# and "Invite users via link" rights. Example: -1009876543210
VIP_CHAT_ID=-1009876543210

# ===== Database (Neon PostgreSQL or local) =====
# Neon example (async driver added automatically at runtime):
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Local docker profile example:
# DATABASE_URL=postgresql+asyncpg://fitness:fitness@postgres:5432/fitness_bot

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=your_gemini_api_key

# ===== Payme Merchant API =====
# Cabinet credentials. The sandbox flag selects which key authenticates callbacks.
PAYME_MERCHANT_ID=your_merchant_id
PAYME_TEST_KEY=your_payme_test_key
PAYME_PROD_KEY=your_payme_production_key
PAYME_SANDBOX=True
# Launch gate: True keeps the Payme button visible as "(Tez kunda)" and a tap only
# shows a "coming soon" notice. Set False to hand payers real Payme checkout links.
PAYME_CHECKOUT_PAUSED=True
# Endpoint bound inside the container; nginx proxies /api/payme to it.
PAYME_HOST=0.0.0.0
PAYME_PORT=8000

# ===== Click SHOP API =====
# Cabinet credentials. CLICK_SECRET_KEY signs every prepare/complete callback,
# which nginx proxies to /api/click/prepare and /api/click/complete.
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# ===== Optional =====
# Tariff banner shown with the tariff card, per interface language.
# Relative paths resolve against the project root.
TARIFFS_IMG_UZ=assets/Tarifs_uz.jpg
TARIFFS_IMG_RU=assets/Tarifs_ru.jpg
# Referral cashback amount in UZS (default 30000)
CASHBACK_REWARD_AMOUNT=30000
# Log file path (default bot.log; Docker uses /app/logs/bot.log)
# LOG_FILE=bot.log

# One process uses at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=600

# Click tutorial: file_id wins over a local path; absent asset -> text instructions.
CLICK_TUTORIAL_VIDEO_PATH=assets/click_instruction.mp4
CLICK_TUTORIAL_VIDEO_ID=
PAYMENT_DELIVERY_CONCURRENCY=4
PAYMENT_DELIVERY_BATCH_SIZE=50
# Only the actual DIRECT proxy IP is trusted. For host networking use:
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# In Docker set the exact observed host bridge gateway; do not trust all private IPs.
TRUSTED_PROXY_IPS=
